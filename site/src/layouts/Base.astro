---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Staging default: block search engines. Flip to false at launch. */
  noindex?: boolean;
  /** Path portion of canonical URL, e.g. "/" or "/about". */
  canonicalPath?: string;
}

const {
  title,
  description,
  noindex = true,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site).toString();

// ponytail: manual constant, bump after each counsel-reviewed material change.
// This is a compliance/register signal, not an auto-timestamp; auto-bumping would misrepresent.
const LAST_REVIEWED = '2026-09-19';
const reviewedLabel = new Date(LAST_REVIEWED).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <link rel="icon" type="image/svg+xml" href="/logo/lswp-mark.svg" />
  <link rel="icon" type="image/png" href="/logo/lswp-mark.png" />
  <link rel="apple-touch-icon" href="/logo/lswp-mark.png" />

  {/* Open Graph */}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Life Story Wealth Planning" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og-image.png', Astro.site).toString()} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL('/og-image.png', Astro.site).toString()} />

  {/* Fonts self-hosted via @fontsource, imported in global.css */}

  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="progress" aria-hidden="true"></div>

  <div class="topbar">
    <div class="topbar-inner">
      <span>Registered Investment Advisor</span>
      <span>Scottsdale, Arizona</span>
    </div>
  </div>

  <div class="nav-wrap">
    <div class="nav-inner">
      <div class="brand">
        <a href="/" class="brand-mark" aria-label="Life Story Wealth Planning">
          <span class="brand-word">Life Story <em>Wealth Planning</em></span>
          <svg viewBox="0 0 44 44" class="brand-mark-glyph" aria-hidden="true">
            <circle cx="22" cy="22" r="20" class="bm-disc" />
            <path class="bm-feather" d="M 14 30 C 16 22 20 15 30 12 C 30 16 28 21 24 25 C 21 27 17 29 14 30 Z" />
            <path class="bm-shaft" d="M 14 30 L 19 25" />
            <path class="bm-underline" d="M 17 33 C 21 32 26 32 32 33" />
          </svg>
        </a>
        <div class="brand-tag">Est. 2024</div>
      </div>
      <button
        type="button"
        class="nav-toggle"
        id="nav-toggle"
        aria-controls="nav-primary"
        aria-expanded="false"
        aria-label="Open navigation"
      >
        <svg viewBox="0 0 24 24" class="nav-toggle-icon" aria-hidden="true">
          <line x1="4" y1="8" x2="20" y2="8" />
          <line x1="4" y1="13" x2="20" y2="13" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
        <span class="nav-toggle-label">Menu</span>
      </button>

      <nav id="nav-primary" class="nav-primary" aria-label="Main navigation">
        <button
          type="button"
          class="nav-close"
          id="nav-close"
          aria-label="Close navigation"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="6" y1="18" x2="18" y2="6" />
          </svg>
        </button>
        <ul>
          <li><a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a></li>
          <li><a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About</a></li>
          <li><a href="/approach" aria-current={Astro.url.pathname === '/approach' ? 'page' : undefined}>Philosophy</a></li>
          <li><a href="/how-we-start" aria-current={Astro.url.pathname === '/how-we-start' ? 'page' : undefined}>Methodology</a></li>
          <li><a href="/fees" aria-current={Astro.url.pathname === '/fees' ? 'page' : undefined}>Fees</a></li>
          <li><a href="/custody" aria-current={Astro.url.pathname === '/custody' ? 'page' : undefined}>Custody</a></li>
          <li><a href="/insights" aria-current={Astro.url.pathname === '/insights' ? 'page' : undefined}>Blog</a></li>
          <li><a href="/contact" aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}>Contact</a></li>
        </ul>
      </nav>
    </div>
  </div>

  <aside class="rail" aria-hidden="true">
    <slot name="rail" />
  </aside>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <h5>Life Story Wealth Planning</h5>
        <p>A small investment advisory firm in Scottsdale, Arizona. Alex Hilbert, Registered Investment Advisor and fiduciary.</p>
      </div>
      <div>
        <h5>Verify</h5>
        <ul>
          <li><a href="https://adviserinfo.sec.gov/firm/summary/332717" target="_blank" rel="noopener">Form ADV</a></li>
          <li><a href="https://adviserinfo.sec.gov/individual/summary/5993000" target="_blank" rel="noopener">Advisor background</a></li>
          <li><a href="https://brokercheck.finra.org/individual/summary/5993000" target="_blank" rel="noopener">FINRA BrokerCheck</a></li>
        </ul>
      </div>
      <div>
        <h5>Contact</h5>
        <ul>
          <li>Scottsdale, Arizona</li>
          <li><a href="/contact">Start a conversation</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">
      <span>© {new Date().getFullYear()} Life Story Wealth Planning</span>
      <span>This site was last reviewed {reviewedLabel}.</span>
      <span>All content is intended for U.S. residents in the states in which the firm is properly registered to conduct business, and is subject to change without notice.</span>
    </div>
  </footer>

  <script>
    (function () {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reading progress, functional, not decorative.
      const bar = document.querySelector<HTMLElement>('.progress');
      function onScroll() {
        const h = document.documentElement;
        const pct = h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight);
        if (bar) bar.style.transform = 'scaleX(' + pct + ')';
      }
      document.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Pedagogical reveal, targets that teach through motion.
      // Custody diagram draws the safeguard relationship; how-starts draws the journey line;
      // differs staggers the comparison; fee-cards stagger the two scenarios; counts-on staggers numerals.
      const revealTargets = document.querySelectorAll<HTMLElement>(
        '.custody-diagram-wrap, .how-starts, .differs, .fee-cards, .counts-on, .zermagen-mark-wrap, .risk-first-mark-wrap, .app-reveal'
      );
      if (revealTargets.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.18 });
        revealTargets.forEach((el) => io.observe(el));
      } else {
        revealTargets.forEach((el) => el.classList.add('is-in'));
      }

      // Right rail active state, wayfinding aid.
      const railLinks = document.querySelectorAll<HTMLAnchorElement>('.rail a');
      if (railLinks.length && 'IntersectionObserver' in window) {
        const ids = Array.from(railLinks).map((a) => a.getAttribute('href')?.slice(1) || '');
        const sections = ids.map((id) => document.getElementById(id));
        const ioRail = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              const i = sections.indexOf(e.target as HTMLElement);
              railLinks.forEach((a, j) => a.classList.toggle('active', j === i));
            }
          });
        }, { rootMargin: '-45% 0px -45% 0px' });
        sections.forEach((s) => { if (s) ioRail.observe(s); });
      }

      // § anchor, click to copy section URL. Referrals travel as specific links.
      document.querySelectorAll<HTMLAnchorElement>('.sect-anchor').forEach((a) => {
        a.addEventListener('click', (ev) => {
          if (!navigator.clipboard) return;
          ev.preventDefault();
          const href = a.getAttribute('href') || '';
          const url = window.location.origin + window.location.pathname + href;
          navigator.clipboard.writeText(url).then(() => {
            history.replaceState(null, '', href);
            a.classList.add('is-copied');
            setTimeout(() => a.classList.remove('is-copied'), 1400);
          }).catch(() => history.replaceState(null, '', href));
        });
      });

      // Highlight-to-share, user selects any text, popover offers to copy quote + link.
      // Because Alex's strategy is content that gets shared.
      const popover = document.createElement('button');
      popover.className = 'share-popover';
      popover.type = 'button';
      popover.textContent = 'Share this quote';
      popover.setAttribute('aria-label', 'Copy selected text with link to clipboard');
      document.body.appendChild(popover);

      let currentQuote = '';
      let currentSectionId = '';

      function findEnclosingSectionId(node: Node | null): string {
        while (node && node !== document.body) {
          if (node instanceof HTMLElement && node.id && node.tagName === 'SECTION') return node.id;
          node = node.parentNode;
        }
        return '';
      }

      function updatePopover() {
        const sel = window.getSelection();
        if (!sel || sel.isCollapsed) { popover.classList.remove('is-visible'); return; }
        const text = sel.toString().trim();
        if (text.length < 12) { popover.classList.remove('is-visible'); return; }
        const range = sel.getRangeAt(0);
        const rect = range.getBoundingClientRect();
        if (!rect.width && !rect.height) { popover.classList.remove('is-visible'); return; }
        currentQuote = text;
        currentSectionId = findEnclosingSectionId(range.startContainer);
        popover.style.left = (rect.left + rect.width / 2) + 'px';
        popover.style.top = rect.top + 'px';
        popover.textContent = 'Share this quote';
        popover.classList.remove('is-copied');
        popover.classList.add('is-visible');
      }

      document.addEventListener('mouseup', () => { setTimeout(updatePopover, 0); });
      document.addEventListener('keyup', (e) => {
        if (e.shiftKey || e.key === 'Shift') setTimeout(updatePopover, 0);
      });
      document.addEventListener('selectionchange', () => {
        const sel = window.getSelection();
        if (!sel || sel.isCollapsed) popover.classList.remove('is-visible');
      });

      popover.addEventListener('click', (ev) => {
        ev.preventDefault();
        if (!navigator.clipboard || !currentQuote) return;
        const url = window.location.origin + window.location.pathname + (currentSectionId ? '#' + currentSectionId : '');
        const payload = '"' + currentQuote + '"\nAlex Hilbert, Life Story Wealth Planning\n' + url;
        navigator.clipboard.writeText(payload).then(() => {
          popover.classList.add('is-copied');
          popover.textContent = 'Copied';
          setTimeout(() => popover.classList.remove('is-visible'), 1400);
        });
      });

      // Credentials strip, click a term to expand its meaning inline.
      document.querySelectorAll<HTMLButtonElement>('.cred-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.dataset.target;
          if (!target) return;
          const wasActive = btn.classList.contains('is-active');
          document.querySelectorAll<HTMLButtonElement>('.cred-btn').forEach((b) => b.classList.remove('is-active'));
          document.querySelectorAll<HTMLElement>('.cred-expand').forEach((e) => (e.hidden = true));
          if (!wasActive) {
            btn.classList.add('is-active');
            const exp = document.querySelector<HTMLElement>(`.cred-expand[data-cred="${target}"]`);
            if (exp) exp.hidden = false;
          }
        });
      });

      // Mobile nav toggle — the desktop bar becomes an accessible fullscreen
      // menu below 640px.
      const navToggle = document.getElementById('nav-toggle');
      const navClose = document.getElementById('nav-close');
      const navPrimary = document.getElementById('nav-primary');
      const setNavOpen = (open: boolean) => {
        if (!navToggle || !navPrimary) return;
        navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        navToggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        navPrimary.classList.toggle('is-open', open);
        document.documentElement.classList.toggle('has-nav-open', open);
      };
      navToggle?.addEventListener('click', () => {
        const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
        setNavOpen(!isOpen);
      });
      navClose?.addEventListener('click', () => setNavOpen(false));
      navPrimary?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setNavOpen(false));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && navToggle?.getAttribute('aria-expanded') === 'true') {
          setNavOpen(false);
          navToggle.focus();
        }
      });

    })();
  </script>
</body>
</html>
