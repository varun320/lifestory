---
import Base from '../layouts/Base.astro';

const title = 'Contact Alex Hilbert · Life Story Wealth Planning · Scottsdale, Arizona';
const description = 'Book a first conversation with Alex Hilbert, Registered Investment Advisor and fiduciary at Life Story Wealth Planning in Scottsdale, Arizona.';

// TODO(arham): drop the real scheduling URL here once the new booking tool is wired.
// Current sitemap doc says scheduling tooling is being changed — see docs/open-gaps.md #6.
const BOOKING_URL = '';

// TODO(alex): confirm the public contact email before launch. See docs/open-gaps.md #5.
const CONTACT_EMAIL = 'alex@lifestorywp.com';
---
<Base title={title} description={description} canonicalPath="/contact">
  <main class="contact-page">
    <section class="contact-hero">
      <p class="contact-eyebrow">        <span>Chapter · Contact</span>      </p>
      <h1 class="contact-h1">A first conversation is <em>a conversation.</em></h1>
      <p class="contact-lede">No fee. No pressure. No obligation. Fifteen minutes on the phone, at a time you pick.</p>
    </section>

    <section class="contact-primary app-reveal" aria-labelledby="primary-h">
      <div class="contact-primary-corner tl" aria-hidden="true"></div>
      <div class="contact-primary-corner tr" aria-hidden="true"></div>
      <div class="contact-primary-corner bl" aria-hidden="true"></div>
      <div class="contact-primary-corner br" aria-hidden="true"></div>

      <svg viewBox="0 0 44 44" class="contact-glyph contact-glyph-call" aria-hidden="true">
        {/* Receiver shape — line-art */}
        <path class="cg-stroke" d="M 12 8 C 14 8 16 10 17 13 L 19 17 C 20 19 20 21 18 22 L 17 23 C 20 28 24 31 30 33 L 31 32 C 33 30 35 30 37 31 L 41 33 C 44 34 45 36 45 38" transform="translate(-3, 0)" />
        {/* Small ripple hint */}
        <circle class="cg-stroke cg-stroke-faint" cx="32" cy="10" r="3" />
        <circle class="cg-stroke cg-stroke-faint" cx="32" cy="10" r="6" />
      </svg>

      <p class="contact-primary-eyebrow">The direct route</p>
      <h2 id="primary-h" class="contact-primary-h">Book a first call</h2>

      <p class="contact-primary-body">
        I keep these short and specific. Enough to hear who introduced you, what's on your
        mind, and whether it makes sense for us to keep talking. No preparation required on
        your side.
      </p>

      {BOOKING_URL ? (
        <div class="contact-primary-cta">
          <a class="cta cta-large" href={BOOKING_URL} target="_blank" rel="noopener">Choose a time</a>
          <p class="contact-primary-fine">Opens my scheduling page. You pick the window; I confirm.</p>
        </div>
      ) : (
        <div class="contact-primary-cta">
          <a class="cta cta-large" href={`mailto:${CONTACT_EMAIL}?subject=Book%20a%20first%20call&body=I'd%20like%20to%20book%20a%20first%20call.%20One%20line%20on%20who%20introduced%20me%20and%20what's%20on%20my%20mind%3A%20`}>Ask for a time</a>
          <p class="contact-primary-fine">
            Scheduling is being moved to a new tool. Until it's live, one line by email.
            I'll reply with two or three windows to pick from, personally.
          </p>
        </div>
      )}
    </section>

    <div class="contact-rule" aria-hidden="true">
      <span class="contact-rule-line"></span>
      <span class="contact-rule-or">or write directly</span>
      <span class="contact-rule-line"></span>
    </div>

    <section class="contact-secondary app-reveal" aria-labelledby="secondary-h">
      <svg viewBox="0 0 44 44" class="contact-glyph contact-glyph-quill" aria-hidden="true">
        {/* Quill feather */}
        <path class="cg-stroke" d="M 8 34 C 12 24 20 14 32 8 C 32 14 30 20 26 24 C 22 28 16 32 8 34 Z" />
        {/* Nib */}
        <path class="cg-stroke cg-stroke-brass" d="M 8 34 L 14 28" />
        {/* Ink drop */}
        <circle class="cg-fill cg-fill-rubric" cx="15" cy="35" r="1.5" />
      </svg>
      <h2 id="secondary-h" class="contact-secondary-h">Send a message</h2>
      <p class="contact-secondary-body">
        Tell me who introduced you and what's on your mind. One paragraph is enough. I reply
        personally, usually within two business days.
      </p>
      <p class="contact-secondary-mail">
        <a class="contact-mail-link" href={`mailto:${CONTACT_EMAIL}?subject=Introduction`}>
          <span class="mail-arrow" aria-hidden="true">→</span>
          <span class="mail-address">{CONTACT_EMAIL}</span>
        </a>
      </p>
    </section>

    <aside class="contact-envelope app-reveal" aria-label="Firm details">
      <p class="env-label">From</p>
      <div class="env-block">
        <p class="env-name">Alex Hilbert</p>
        <p class="env-line">Life Story Wealth Planning</p>
        <p class="env-line">Scottsdale, Arizona</p>
        <p class="env-line env-line-quiet">Registered Investment Advisor · Fiduciary since 2012</p>
      </div>
      <p class="env-verify">
        Verify before you write.
        <a href="https://adviserinfo.sec.gov/" target="_blank" rel="noopener">Form ADV</a>
        ·
        <a href="https://brokercheck.finra.org/" target="_blank" rel="noopener">FINRA BrokerCheck</a>
      </p>
    </aside>

    <p class="contact-postscript">
      P.S. If you haven't already, the <a href="/about">About page</a> is what most people
      read first: the Vanguard-to-independent origin story and how to verify me before we speak.
    </p>
  </main>
</Base>

<style>
  .contact-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(3rem, 5vw, 6rem) clamp(1.5rem, 4vw, 3rem) clamp(4rem, 6vw, 8rem);
    display: grid;
    grid-template-columns: [outer-l] 1fr [main] minmax(0, 720px) [outer-r] 1fr;
    row-gap: clamp(2rem, 4vw, 4rem);
    color: var(--ink, #1c1712);
  }

  .contact-page > * { grid-column: main; }

  /* Hero */
  .contact-hero { text-align: center; }
  .contact-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'Source Sans 3', system-ui, sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rubric, #8a3324);
    font-weight: 500;
    margin-bottom: 1.75rem;
  }
  .contact-eyebrow-dash {
    display: inline-block;
    width: 28px;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }
  .contact-h1 {
    font-family: 'Fraunces', 'Vollkorn', Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
    font-variation-settings: 'opsz' 144, 'SOFT' 60;
  }
  .contact-h1 em {
    font-style: italic;
    color: var(--rubric, #8a3324);
    font-weight: 400;
  }
  .contact-lede {
    font-family: 'Vollkorn', Georgia, serif;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
    color: rgba(28, 23, 18, 0.78);
    max-width: 46ch;
    margin: 0 auto;
  }

  /* Primary tile — the anchor moment */
  .contact-primary {
    position: relative;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3.5rem);
    background: var(--paper-2, #f4ecdc);
    border: 1px solid rgba(138, 51, 36, 0.18);
    box-shadow: 0 24px 60px -32px rgba(28, 23, 18, 0.28);
    text-align: center;
  }
  .contact-primary-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--rubric, #8a3324);
  }
  .contact-primary-corner.tl { top: -1px; left: -1px; border-right: none; border-bottom: none; }
  .contact-primary-corner.tr { top: -1px; right: -1px; border-left: none; border-bottom: none; }
  .contact-primary-corner.bl { bottom: -1px; left: -1px; border-right: none; border-top: none; }
  .contact-primary-corner.br { bottom: -1px; right: -1px; border-left: none; border-top: none; }

  /* Reveal animation on primary tile */
  .contact-primary {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 800ms ease, transform 800ms ease;
  }
  .contact-primary.is-in { opacity: 1; transform: none; }

  /* Glyphs — small line-art marks above sections */
  .contact-glyph {
    display: block;
    width: clamp(36px, 4vw, 48px);
    height: clamp(36px, 4vw, 48px);
    margin: 0 auto 1rem;
    font-family: 'Source Sans 3', system-ui, sans-serif;
  }
  .contact-glyph .cg-stroke {
    fill: none;
    stroke: var(--rubric, #8a3324);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 180;
    stroke-dashoffset: 180;
    transition: stroke-dashoffset 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) 250ms;
  }
  .contact-glyph .cg-stroke-faint { stroke: rgba(138, 51, 36, 0.28); }
  .contact-glyph .cg-stroke-brass { stroke: color-mix(in oklab, var(--brass-soft, #c9a15a) 70%, var(--ink, #1c1712) 30%); }
  .contact-glyph .cg-fill {
    fill: var(--rubric, #8a3324);
    opacity: 0;
    transition: opacity 500ms ease 900ms;
  }
  .contact-glyph .cg-fill-rubric { fill: var(--rubric, #8a3324); }
  .app-reveal.is-in .contact-glyph .cg-stroke { stroke-dashoffset: 0; }
  .app-reveal.is-in .contact-glyph .cg-fill { opacity: 1; }

  /* Secondary + envelope reveal */
  .contact-secondary,
  .contact-envelope {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 800ms ease, transform 800ms ease;
  }
  .contact-secondary.is-in,
  .contact-envelope.is-in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .contact-primary, .contact-secondary, .contact-envelope,
    .contact-glyph .cg-stroke, .contact-glyph .cg-fill {
      opacity: 1; transform: none; transition: none; stroke-dashoffset: 0;
    }
  }

  .contact-primary-eyebrow {
    font-family: 'Source Sans 3', system-ui, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--rubric, #8a3324);
    font-weight: 600;
    margin: 0 0 1.5rem;
  }
  .contact-primary-h {
    font-family: 'Fraunces', 'Vollkorn', Georgia, serif;
    font-weight: 400;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.005em;
    margin: 0 0 1.25rem;
    font-variation-settings: 'opsz' 120, 'SOFT' 40;
  }
  .contact-primary-body {
    font-family: 'Vollkorn', Georgia, serif;
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgba(28, 23, 18, 0.85);
    max-width: 50ch;
    margin: 0 auto 2.25rem;
  }
  .contact-primary-cta { display: flex; flex-direction: column; align-items: center; gap: 0.9rem; }
  .cta-large {
    font-size: 1.05rem;
    padding: 0.95rem 2.25rem;
    letter-spacing: 0.02em;
  }
  .contact-primary-fine {
    font-family: 'Source Sans 3', system-ui, sans-serif;
    font-size: 0.85rem;
    color: rgba(28, 23, 18, 0.62);
    max-width: 42ch;
    line-height: 1.5;
    margin: 0;
    font-style: italic;
  }

  /* "or write directly" hairline break */
  .contact-rule {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .contact-rule-line {
    flex: 1;
    height: 1px;
    background: rgba(28, 23, 18, 0.18);
  }
  .contact-rule-or {
    font-family: 'Source Sans 3', system-ui, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(28, 23, 18, 0.55);
    font-weight: 500;
  }

  /* Secondary — quieter, smaller */
  .contact-secondary { text-align: center; }
  .contact-secondary-h {
    font-family: 'Fraunces', 'Vollkorn', Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.4rem, 2vw, 1.7rem);
    margin: 0 0 0.75rem;
    font-variation-settings: 'opsz' 96, 'SOFT' 30;
  }
  .contact-secondary-body {
    font-family: 'Vollkorn', Georgia, serif;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(28, 23, 18, 0.75);
    max-width: 46ch;
    margin: 0 auto 1.25rem;
  }
  .contact-mail-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: 'Source Sans 3', system-ui, sans-serif;
    text-decoration: none;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--rubric, #8a3324);
    color: var(--ink, #1c1712);
    transition: color 200ms ease, gap 200ms ease;
  }
  .contact-mail-link:hover, .contact-mail-link:focus-visible { color: var(--rubric, #8a3324); gap: 0.9rem; }
  .mail-arrow { color: var(--rubric, #8a3324); font-size: 0.95em; }
  .mail-address { letter-spacing: 0.06em; font-size: 0.98rem; }

  /* Envelope — decorative aside with firm details + verify */
  .contact-envelope {
    grid-column: main;
    max-width: 560px;
    margin: 0 auto;
    padding: 1.75rem 2rem;
    border: 1px solid rgba(28, 23, 18, 0.18);
    background: transparent;
    position: relative;
    font-family: 'Source Sans 3', system-ui, sans-serif;
  }
  .contact-envelope::before,
  .contact-envelope::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 22px;
    background:
      linear-gradient(45deg, transparent 49%, rgba(28, 23, 18, 0.14) 49.5%, rgba(28, 23, 18, 0.14) 50.5%, transparent 51%) 0 0 / 16px 22px repeat-x;
    opacity: 0.4;
  }
  .contact-envelope::before { top: -1px; }
  .contact-envelope::after { bottom: -1px; transform: scaleY(-1); }
  .env-label {
    font-size: 0.68rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--rubric, #8a3324);
    font-weight: 600;
    margin: 0 0 0.75rem;
  }
  .env-block { margin-bottom: 1rem; }
  .env-name {
    font-family: 'Fraunces', 'Vollkorn', Georgia, serif;
    font-weight: 500;
    font-size: 1.15rem;
    margin: 0 0 0.2rem;
    font-variation-settings: 'opsz' 96;
  }
  .env-line {
    font-size: 0.92rem;
    color: rgba(28, 23, 18, 0.78);
    margin: 0 0 0.15rem;
    line-height: 1.4;
  }
  .env-line-quiet {
    color: rgba(28, 23, 18, 0.55);
    font-style: italic;
    font-size: 0.85rem;
    margin-top: 0.4rem;
  }
  .env-verify {
    font-size: 0.82rem;
    color: rgba(28, 23, 18, 0.62);
    margin: 0;
    padding-top: 0.85rem;
    border-top: 1px dashed rgba(28, 23, 18, 0.18);
  }
  .env-verify a {
    color: var(--rubric, #8a3324);
    text-decoration: none;
    border-bottom: 1px solid rgba(138, 51, 36, 0.35);
  }
  .env-verify a:hover { border-bottom-color: var(--rubric, #8a3324); }

  /* Postscript */
  .contact-postscript {
    max-width: 52ch;
    margin: 0 auto;
    text-align: center;
    font-family: 'Vollkorn', Georgia, serif;
    font-style: italic;
    font-size: 0.98rem;
    color: rgba(28, 23, 18, 0.68);
    line-height: 1.6;
  }
  .contact-postscript a {
    color: var(--rubric, #8a3324);
    text-decoration: none;
    border-bottom: 1px solid rgba(138, 51, 36, 0.4);
  }
  .contact-postscript a:hover { border-bottom-color: var(--rubric, #8a3324); }

  @media (max-width: 640px) {
    .contact-primary { padding: 2rem 1.5rem; }
    .contact-envelope { padding: 1.5rem 1.25rem; }
    .contact-envelope::before,
    .contact-envelope::after { display: none; }
  }
</style>
