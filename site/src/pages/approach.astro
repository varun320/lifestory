    font-family: 'Fraunces Variable', 'Fraunces', 'Vollkorn', Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.6rem, 5.5vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin: 0 0 1.25rem;
    font-variation-settings: 'opsz' 144, 'SOFT' 60;
  }
  .app-title em { font-style: italic; color: var(--rubric, #8a3324); font-weight: 400; }
  .app-deck {
    font-family: 'Vollkorn', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
